# Crypto-Heranca Keeper Environment Variables

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Keeper Wallet (Base58 private key — keep secret!)
KEEPER_PRIVATE_KEY=your_base58_private_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# API Server
API_PORT=3000
API_RATE_LIMIT_PER_MINUTE=100

# Monitoring
MONITOR_INTERVAL_MINUTES=5
CLAIM_CHECK_INTERVAL_MINUTES=5

# Program ID
PROGRAM_ID=your-program-ID

# Logging
LOG_LEVEL=info

# Notifications (optional — required for email/SMS alerts)
# Set to true to enable notifications
NOTIFICATIONS_ENABLED=false

# SendGrid (Email)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=notifications@herita.xyz

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Notification thresholds
EXPIRY_WARNING_THRESHOLD_PERCENT=25
